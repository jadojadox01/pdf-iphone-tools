# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.tmp-test

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# generated media copies (canonical bytes live in the CMS database)
/public/uploads/media/*
!/public/uploads/media/.gitkeep

# OCR engine assets (copied on postinstall)
/public/tesseract/*.wasm
/public/tesseract/*.wasm.js
/public/tesseract/*.gz

