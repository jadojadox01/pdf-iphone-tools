generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/cms.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  description    String       @default("")
  intro          String       @default("")
  icon           String       @default("")
  status         String       @default("draft")
  sortOrder      Int          @default(0)
  seoTitle       String       @default("")
  seoDescription String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tools          ToolDevice[]
  guides         Guide[]
}

model Tool {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  processorKey   String       @default("")
  description    String       @default("")
  intro          String       @default("")
  category       String       @default("convert")
  inputFormat    String       @default("pdf")
  outputFormat   String       @default("")
  status         String       @default("live")
  cta            String       @default("")
  seoTitle       String       @default("")
  seoDescription String       @default("")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  devices        ToolDevice[]
  guides         GuideTool[]
}

model ToolDevice {
  toolId    String
  deviceId  String
  featured  Boolean @default(false)
  headline  String  @default("")
  intro     String  @default("")
  sortOrder Int     @default(0)
  tool      Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  device    Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([toolId, deviceId])
}

model Author {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  bio       String   @default("")
  role      String   @default("")
  avatarId  String?
  website   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guides    Guide[]
  avatar    Media?   @relation("AuthorAvatar", fields: [avatarId], references: [id])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guides      Guide[]
}

model Tag {
  id     String     @id @default(cuid())
  name   String
  slug   String     @unique
  guides GuideTag[]
}

model Media {
  id          String   @id @default(cuid())
  filename    String
  mimeType    String
  alt         String   @default("")
  caption     String   @default("")
  url         String   @default("")
  width       Int?
  height      Int?
  size        Int      @default(0)
  data        Bytes?
  createdAt   DateTime @default(now())
  featuredFor Guide[]  @relation("FeaturedImage")
  ogFor       Guide[]  @relation("OgImage")
  authors     Author[] @relation("AuthorAvatar")
}

model Guide {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String    @default("")
  template        String    @default("HOW_TO")
  blocksJson      String    @default("[]")
  searchText      String    @default("")
  status          String    @default("draft")
  featured        Boolean   @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  readingTime     Int       @default(1)
  seoTitle        String    @default("")
  seoDescription  String    @default("")
  canonicalUrl    String    @default("")
  robots          String    @default("index,follow")
  focusTopic      String    @default("")
  featuredImageId String?
  ogImageId       String?
  authorId        String?
  categoryId      String?
  deviceId        String?

  author        Author?         @relation(fields: [authorId], references: [id])
  category      Category?       @relation(fields: [categoryId], references: [id])
  device        Device?         @relation(fields: [deviceId], references: [id])
  featuredImage Media?          @relation("FeaturedImage", fields: [featuredImageId], references: [id])
  ogImage       Media?          @relation("OgImage", fields: [ogImageId], references: [id])
  tags          GuideTag[]
  relatedTools  GuideTool[]
  relatedFrom   GuideRelation[] @relation("FromGuide")
  relatedTo     GuideRelation[] @relation("ToGuide")
  revisions     GuideRevision[]

  @@index([status, publishedAt])
  @@index([slug])
  @@index([deviceId])
}

model GuideTag {
  guideId String
  tagId   String
  guide   Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([guideId, tagId])
}

model GuideTool {
  guideId String
  toolId  String
  guide   Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  tool    Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([guideId, toolId])
}

model GuideRelation {
  fromId String
  toId   String
  from   Guide @relation("FromGuide", fields: [fromId], references: [id], onDelete: Cascade)
  to     Guide @relation("ToGuide", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

model GuideRevision {
  id         String   @id @default(cuid())
  guideId    String
  title      String
  excerpt    String   @default("")
  blocksJson String
  createdAt  DateTime @default(now())
  guide      Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  statusCode Int     @default(301)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
